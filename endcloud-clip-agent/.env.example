# ===== 云端大模型：DeepSeek Flash（多模态，支持看图）=====
# 复制本文件为 .env 后填写；.env 不要提交、不要外发
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# 强制模型只返回 JSON（prompt 里已含 json 字样，不会触发 400）
LLM_JSON_MODE=true
# 关闭后只发文字需求 + 关键帧时间点，不传图片
LLM_VISION=true
LLM_TIMEOUT=180
LLM_MAX_RETRY=2
# 推理模型的思考过程也占 completion tokens，太小会导致 content 为空
LLM_MAX_TOKENS=4096

# ===== 本地固定目录（Windows）=====
# 默认根目录：D:\Trae work\Trae work处理文件夹（含空格，代码用 pathlib 处理，无需转义）
# 不填则 Windows 用上面默认值，其它系统回退到 项目内 data/
# DATA_ROOT=D:\Trae work\Trae work处理文件夹
# VIDEO_SRC_DIR=D:\Trae work\Trae work处理文件夹\视频素材
# VIDEO_OUT_DIR=D:\Trae work\Trae work处理文件夹\视频成片
# LOG_DIR=D:\Trae work\Trae work处理文件夹\剪辑Agent日志
# FRAME_CACHE_DIR=D:\Trae work\Trae work处理文件夹\temp_frame
# FFmpeg 切片中转目录（与抽帧缓存分开）
# TEMP_DIR=D:\Trae work\Trae work处理文件夹\temp_clip
# ARCHIVE_DIR=D:\Trae work\Trae work处理文件夹\归档
# BGM_DIR=D:\Trae work\Trae work处理文件夹\BGM

# ===== 抽帧（只上传关键帧，原始视频不出本地）=====
# 3–8 张，超出范围会自动夹到边界
FRAME_COUNT=5
FRAME_WIDTH=720
# 抽帧质量 2–10，数字越小越清晰
FRAME_QUALITY=3
# 单张体积上限（KB），超限自动降分辨率 + 降质量重压
FRAME_MAX_KB=180

# ===== 导出 =====
# 宽或高填 0 表示跟随源视频尺寸
OUT_WIDTH=1080
OUT_HEIGHT=1920
OUT_FPS=30
OUT_CRF=18
OUT_PRESET=veryfast
BGM_VOLUME=0.25

# ===== 字幕 =====
SUBTITLE_FONT=Microsoft YaHei
SUBTITLE_SIZE=68
# 0 表示自动（竖屏约 18% 高度，横屏约 7%）
SUBTITLE_MARGIN_V=0
SUBTITLE_FONTS_DIR=C:\Windows\Fonts
