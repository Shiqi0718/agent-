# ===== 云端大模型（OpenAI 兼容接口）=====
# 复制本文件为 .env 后填写；.env 不要提交、不要外发
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 是否要求模型返回 JSON（多数 OpenAI 兼容服务支持；报错可改 false）
LLM_JSON_MODE=true
# 模型是否支持图片输入（不支持就设 false，只发文字+关键帧时间点）
LLM_VISION=true
LLM_TIMEOUT=120
LLM_MAX_RETRY=2

# ===== 本地路径（Windows 默认值）=====
# 不填则 Windows 使用 D:\豆包\数据，其它系统使用 项目内 data/
# DATA_ROOT=D:\豆包\数据
# VIDEO_SRC_DIR=D:\豆包\数据\视频素材
# VIDEO_OUT_DIR=D:\豆包\数据\视频成片
# LOG_DIR=D:\豆包\数据\日志
# 临时切片目录；若中文路径导致字幕烧录异常，可改到纯英文路径（如 C:\temp\clip）
# TEMP_DIR=C:\temp\clip

# ===== 抽帧 =====
FRAME_COUNT=5
FRAME_WIDTH=720

# ===== 导出 =====
# 宽或高填 0 表示跟随源视频尺寸
OUT_WIDTH=1080
OUT_HEIGHT=1920
OUT_FPS=30
OUT_CRF=18
OUT_PRESET=veryfast
BGM_VOLUME=0.25

# ===== 字幕 =====
SUBTITLE_FONT=Microsoft YaHei
SUBTITLE_SIZE=68
# 0 表示自动（竖屏约 18% 高度，横屏约 7%）
SUBTITLE_MARGIN_V=0
SUBTITLE_FONTS_DIR=C:\Windows\Fonts
